# One-time setup: create ONE permanent admin test account (SQL editor):
#   select set_config('sanad.privileged_write','on',true);
#   update profiles set is_admin = true where id = '<uuid>';
# Name it so it is never matched by the mobile e2e suite's cleanup query
# (`email like 'sanad-e2e-%'`) - do NOT use that prefix here.
E2E_ADMIN_EMAIL=admin-e2e@yourdomain.example
E2E_ADMIN_PASSWORD=change-me
