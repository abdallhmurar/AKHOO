{
  "expo": {
    "name": "أخوو",
    "slug": "sanad",
    "scheme": "akhoo",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.akhoo.help",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "9"
    },
    "android": {
      "package": "app.akhoo.help",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "أخوو يحتاج موقعك لإرسال طلب المساعدة للمتطوعين القريبين منك. / AKHOO needs your location to send your help request to nearby volunteers. / לאחוו דרוש המיקום שלך כדי לשלוח את בקשת העזרה למתנדבים קרובים.",
          "locationAlwaysAndWhenInUsePermission": "أخوو يحتاج موقعك أثناء التوفر كمتطوع حتى تظهر لك الطلبات القريبة حتى لو التطبيق بالخلفية. / AKHOO needs your location while you're available as a volunteer, so nearby requests reach you even in the background. / לאחוו דרוש המיקום שלך בזמן זמינותך כמתנדב, כדי שבקשות קרובות יגיעו אליך גם ברקע.",
          "isAndroidBackgroundLocationEnabled": true,
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1768E5"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "أخوو يحتاج الوصول لصورك حتى تختار صورة شخصية أو صورة لطلب المساعدة. / AKHOO needs access to your photos so you can pick a profile picture or a photo for a help request. / לאחוו דרוש גישה לתמונות שלך כדי לבחור תמונת פרופיל או תמונה לבקשת עזרה.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "aa20e078-807b-4a20-ab29-b36f36d491de"
      }
    },
    "owner": "abad003",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/aa20e078-807b-4a20-ab29-b36f36d491de"
    }
  }
}
