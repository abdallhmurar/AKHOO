      "supportsTablet": true,
      "bundleIdentifier": "app.sanad.help",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "app.sanad.help"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "سَنَد يحتاج موقعك لإرسال طلب المساعدة للمتطوعين القريبين منك."
        }
      ]
    ]
  }
}
